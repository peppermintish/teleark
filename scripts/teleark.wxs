<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Keep this UpgradeCode and component identities stable across releases. -->
  <Package Name="TeleArk" Manufacturer="TeleArk Contributors" Version="$(var.AppVersion)"
           UpgradeCode="12A5E8E9-C9D4-4B19-A318-9FE2415F4079" Language="1033"
           Scope="perUser" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of TeleArk is already installed. Downgrading is not permitted. No files have been changed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="WINDOWSBUILD">
      <RegistrySearch Id="WindowsBuildNumber" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 17763)"
            Message="TeleArk requires Windows 10 version 1809 or later on a system that supports x64 applications." />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Rebuilt packages with the same numeric version must replace their payload too. -->
    <Property Id="REINSTALLMODE" Value="amus" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Kangarooss/teleark" />
    <Property Id="ARPPRODUCTICON" Value="TeleArkIcon" />
    <Icon Id="TeleArkIcon" SourceFile="$(var.IconPath)" />

    <!-- Read both MSI and previous per-user Inno locations before resolving directories. -->
    <Property Id="MSIINSTALLFOLDER">
      <RegistrySearch Id="PreviousMsiFolder" Root="HKCU" Key="Software\TeleArk\Installer"
                      Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="LEGACYINSTALLFOLDER">
      <RegistrySearch Id="LegacyFolder" Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{9A67D26D-7281-4FE9-B942-D6D2A8719DF5}_is1"
                      Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="LEGACYREGISTERED">
      <RegistrySearch Id="LegacyRegistration" Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{9A67D26D-7281-4FE9-B942-D6D2A8719DF5}_is1"
                      Name="DisplayVersion" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="LEGACYCOMPATIBLE">
      <RegistrySearch Id="LegacyCompatibleFolder" Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{9A67D26D-7281-4FE9-B942-D6D2A8719DF5}_is1"
                      Name="InstallLocation" Type="directory" Bitness="always64">
        <DirectorySearch Id="LegacyExecutableFolder" Depth="0">
          <FileSearch Id="LegacyExecutable" Name="teleark.exe" MinVersion="0.0.0.0"
                      MaxVersion="$(var.AppVersion).65535" />
        </DirectorySearch>
      </RegistrySearch>
    </Property>
    <Launch Condition="Installed OR NOT (LEGACYREGISTERED OR LEGACYINSTALLFOLDER) OR LEGACYCOMPATIBLE"
            Message="The existing TeleArk version is newer or could not be verified. Downgrading is not permitted. No files have been changed. Use an installer at least as new as the installed application." />
    <SetProperty Id="INSTALLFOLDER" Action="UseMsiInstallFolder" Value="[MSIINSTALLFOLDER]" After="AppSearch" Sequence="both"
                 Condition="MSIINSTALLFOLDER" />
    <SetProperty Id="INSTALLFOLDER" Action="UseLegacyInstallFolder" Value="[LEGACYINSTALLFOLDER]" After="UseMsiInstallFolder" Sequence="both"
                 Condition="NOT MSIINSTALLFOLDER AND LEGACYINSTALLFOLDER" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="TeleArk">
          <Component Id="Application" Guid="6BA13742-BC89-44B4-82E7-0A368BF3812E">
            <File Id="ApplicationExe" Source="$(var.SourceDir)/teleark.exe" />
            <RegistryValue Root="HKCU" Key="Software\TeleArk\Installer" Name="InstallLocation"
                           Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            <RemoveFolder Id="RemoveEmptyProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
          </Component>
          <Component Id="Documentation" Guid="2A16B53C-56F5-4644-9BF2-C7DD4053B72A">
            <File Source="$(var.SourceDir)/README.md" />
            <File Source="$(var.SourceDir)/LICENSE-MIT" />
            <File Source="$(var.SourceDir)/LICENSE-APACHE" />
            <File Source="$(var.SourceDir)/THIRD_PARTY_NOTICES.md" />
            <RegistryValue Root="HKCU" Key="Software\TeleArk\Installer" Name="Documentation"
                           Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <!-- MSI's transaction removes only obsolete installer-owned metadata/files. -->
          <Component Id="LegacyMigration" Guid="*" Bitness="always64" Condition="LEGACYREGISTERED">
            <RemoveRegistryKey Root="HKCU"
                Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{9A67D26D-7281-4FE9-B942-D6D2A8719DF5}_is1"
                Action="removeOnInstall" />
            <RemoveFile Id="LegacyUninstaller" Name="unins000.exe" On="install" />
            <RemoveFile Id="LegacyUninstallerData" Name="unins000.dat" On="install" />
            <RemoveFile Id="LegacyUninstallerMessages" Name="unins000.msg" On="install" />
            <RegistryValue Root="HKCU" Key="Software\TeleArk\Installer" Name="MigratedInno"
                           Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartTeleArk" Name="TeleArk" Target="[#ApplicationExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\TeleArk\Installer" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="TeleArk" Title="TeleArk" Level="1">
      <ComponentRef Id="Application" />
      <ComponentRef Id="Documentation" />
      <ComponentRef Id="LegacyMigration" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
